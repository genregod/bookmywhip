# BookMyWhip Mobile App Environment Variables

# API Configuration
API_BASE_URL=https://api.bookmywhip.com
API_VERSION=v1

# Azure Maps Configuration
AZURE_MAPS_SUBSCRIPTION_KEY=your_azure_maps_subscription_key_here

# Payment Configuration
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Feature Flags
ENABLE_SOUNDTRACK_FEATURES=true
ENABLE_WAZE_INTEGRATION=false