{
  "name": "bookmywhip-mobile",
  "version": "1.0.0",
  "description": "BookMyWhip Mobile App",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "mock-build": "node scripts/mock-build.js",
    "build:all": "node scripts/build-all.js",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace BookMyWhip.xcworkspace -scheme BookMyWhip -configuration Release -sdk iphoneos -archivePath ./build/BookMyWhip.xcarchive archive CODE_SIGN_IDENTITY=\"\" CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO",
    "fastlane:android": "cd android && fastlane android build_apk",
    "fastlane:ios": "cd ios && fastlane ios build",
    "test": "jest",
    "lint": "eslint .",
    "prepare-release": "node scripts/prepare-release.js"
  },
  "dependencies": {
    "@azure/maps-control": "^2.0.4",
    "@react-native-async-storage/async-storage": "^1.18.1",
    "@react-native-community/geolocation": "^3.0.6",
    "@react-native-picker/picker": "^2.4.10",
    "@react-navigation/bottom-tabs": "^6.5.7",
    "@react-navigation/drawer": "^6.6.2",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/native-stack": "^6.9.12",
    "@stripe/stripe-react-native": "^0.30.0",
    "axios": "^1.3.6",
    "react": "18.2.0",
    "react-native": "0.72.0",
    "react-native-config": "^1.5.1",
    "react-native-gesture-handler": "^2.9.0",
    "react-native-maps": "^1.7.1",
    "react-native-reanimated": "^3.1.0",
    "react-native-safe-area-context": "^4.5.2",
    "react-native-screens": "^3.20.0",
    "react-native-sound": "^0.11.2",
    "react-native-vector-icons": "^9.2.0",
    "socket.io-client": "^4.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.0",
    "@tsconfig/react-native": "^3.0.0",
    "@types/metro-config": "^0.76.3",
    "@types/react": "^18.0.24",
    "@types/react-native": "^0.72.0",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.5",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "typescript": "4.8.4"
  },
  "engines": {
    "node": ">=16"
  }
}