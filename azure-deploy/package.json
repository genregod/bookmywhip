{
  "name": "bookmywhip-azure-functions",
  "version": "1.0.0",
  "description": "Azure Functions for the BookMyWhip ride-hailing platform",
  "scripts": {
    "build": "tsc",
    "build:production": "npm run prestart && npm prune --production",
    "watch": "tsc --watch",
    "prestart": "npm run build && func extensions install",
    "start:host": "func start",
    "start": "npm run start:host",
    "test": "echo \"No tests yet...\"",
    "package": "npm run build && cd .. && zip -r app.zip ./azure-deploy/*"
  },
  "dependencies": {
    "@azure/functions": "^3.0.0",
    "@azure/identity": "^2.0.1",
    "@azure/arm-apimanagement": "^8.1.0",
    "@neondatabase/serverless": "^0.1.5"
  },
  "devDependencies": {
    "@azure/functions": "^3.0.0",
    "@types/node": "^16.x",
    "typescript": "^4.0.0"
  }
}