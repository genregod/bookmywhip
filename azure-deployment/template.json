{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "bookmywhip",
      "metadata": {
        "description": "Base name for all resources"
      }
    },
    "appServicePlanName": {
      "type": "string",
      "defaultValue": "[format('{0}-asp', parameters('appName'))]",
      "metadata": {
        "description": "Name of the App Service Plan"
      }
    },
    "functionAppName": {
      "type": "string",
      "defaultValue": "[format('{0}-func', parameters('appName'))]",
      "metadata": {
        "description": "Name of the Function App"
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "[format('{0}storage', toLower(replace(parameters('appName'), '-', '')))]",
      "metadata": {
        "description": "Name of the Storage Account"
      }
    },
    "appInsightsName": {
      "type": "string",
      "defaultValue": "[format('{0}-insights', parameters('appName'))]",
      "metadata": {
        "description": "Name of the Application Insights resource"
      }
    },
    "signalRName": {
      "type": "string",
      "defaultValue": "[format('{0}-signalr', parameters('appName'))]",
      "metadata": {
        "description": "Name of the SignalR service"
      }
    },
    "apiManagementName": {
      "type": "string",
      "defaultValue": "[format('{0}-apim', parameters('appName'))]",
      "metadata": {
        "description": "Name of the API Management service"
      }
    },
    "apiManagementPublisherEmail": {
      "type": "string",
      "defaultValue": "admin@bookmywhip.com",
      "metadata": {
        "description": "Email address of the API Management publisher"
      }
    },
    "apiManagementPublisherName": {
      "type": "string",
      "defaultValue": "BookMyWhip",
      "metadata": {
        "description": "Name of the API Management publisher"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "appServicePlanSku": {
      "type": "string",
      "defaultValue": "Y1",
      "allowedValues": [
        "Y1",
        "B1",
        "S1"
      ],
      "metadata": {
        "description": "SKU for the App Service Plan (Y1 = Consumption Plan, B1 = Basic, S1 = Standard)"
      }
    },
    "signalRSku": {
      "type": "string",
      "defaultValue": "Free_F1",
      "allowedValues": [
        "Free_F1",
        "Standard_S1"
      ],
      "metadata": {
        "description": "SKU for the SignalR service"
      }
    },
    "apiManagementSku": {
      "type": "string",
      "defaultValue": "Developer",
      "allowedValues": [
        "Developer",
        "Basic",
        "Standard",
        "Premium"
      ],
      "metadata": {
        "description": "SKU for the API Management service"
      }
    },
    "apiManagementSkuCount": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Number of units for the API Management SKU"
      }
    }
  },
  "variables": {
    "functionAppId": "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]",
    "storageAccountId": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
    "appInsightsId": "[resourceId('Microsoft.Insights/components', parameters('appInsightsName'))]",
    "signalRId": "[resourceId('Microsoft.SignalR/SignalR', parameters('signalRName'))]",
    "apiManagementId": "[resourceId('Microsoft.ApiManagement/service', parameters('apiManagementName'))]",
    "driverMatchingApiName": "driver-matching-api"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2021-08-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      },
      "properties": {
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2"
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[parameters('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "Request_Source": "rest",
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled"
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2021-03-01",
      "name": "[parameters('appServicePlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('appServicePlanSku')]"
      },
      "properties": {}
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2021-03-01",
      "name": "[parameters('functionAppName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
        "[resourceId('Microsoft.Insights/components', parameters('appInsightsName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
        "siteConfig": {
          "appSettings": [
            {
              "name": "AzureWebJobsStorage",
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};EndpointSuffix={1};AccountKey={2}', parameters('storageAccountName'), environment().suffixes.storage, listKeys(variables('storageAccountId'), '2021-08-01').keys[0].value)]"
            },
            {
              "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};EndpointSuffix={1};AccountKey={2}', parameters('storageAccountName'), environment().suffixes.storage, listKeys(variables('storageAccountId'), '2021-08-01').keys[0].value)]"
            },
            {
              "name": "WEBSITE_CONTENTSHARE",
              "value": "[toLower(parameters('functionAppName'))]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference(variables('appInsightsId'), '2020-02-02').InstrumentationKey]"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "node"
            },
            {
              "name": "WEBSITE_NODE_DEFAULT_VERSION",
              "value": "~16"
            },
            {
              "name": "AzureSignalRConnectionString",
              "value": "[listKeys(variables('signalRId'), '2022-02-01').primaryConnectionString]"
            }
          ]
        },
        "httpsOnly": true
      }
    },
    {
      "type": "Microsoft.SignalR/SignalR",
      "apiVersion": "2022-02-01",
      "name": "[parameters('signalRName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('signalRSku')]",
        "tier": "[if(equals(parameters('signalRSku'), 'Free_F1'), 'Free', 'Standard')]",
        "capacity": 1
      },
      "properties": {
        "features": [
          {
            "flag": "ServiceMode",
            "value": "Default"
          }
        ]
      }
    },
    {
      "type": "Microsoft.ApiManagement/service",
      "apiVersion": "2021-08-01",
      "name": "[parameters('apiManagementName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('apiManagementSku')]",
        "capacity": "[parameters('apiManagementSkuCount')]"
      },
      "properties": {
        "publisherEmail": "[parameters('apiManagementPublisherEmail')]",
        "publisherName": "[parameters('apiManagementPublisherName')]"
      }
    },
    {
      "type": "Microsoft.ApiManagement/service/apis",
      "apiVersion": "2021-08-01",
      "name": "[format('{0}/{1}', parameters('apiManagementName'), variables('driverMatchingApiName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service', parameters('apiManagementName'))]"
      ],
      "properties": {
        "displayName": "Driver Matching API",
        "apiRevision": "1",
        "description": "API for the advanced driver-rider matching algorithm",
        "subscriptionRequired": true,
        "path": "driver-matching",
        "protocols": [
          "https"
        ]
      }
    },
    {
      "type": "Microsoft.ApiManagement/service/apis/operations",
      "apiVersion": "2021-08-01",
      "name": "[format('{0}/{1}/find-nearby-drivers', parameters('apiManagementName'), variables('driverMatchingApiName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service/apis', parameters('apiManagementName'), variables('driverMatchingApiName'))]"
      ],
      "properties": {
        "displayName": "Find Nearby Drivers",
        "method": "POST",
        "urlTemplate": "/nearby-drivers",
        "description": "Find nearby drivers based on location, radius, and vehicle preferences"
      }
    },
    {
      "type": "Microsoft.ApiManagement/service/apis/operations",
      "apiVersion": "2021-08-01",
      "name": "[format('{0}/{1}/match-optimal-driver', parameters('apiManagementName'), variables('driverMatchingApiName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service/apis', parameters('apiManagementName'), variables('driverMatchingApiName'))]"
      ],
      "properties": {
        "displayName": "Match Optimal Driver",
        "method": "POST",
        "urlTemplate": "/optimal-match",
        "description": "Match the optimal driver based on proximity, rating, and other factors"
      }
    },
    {
      "type": "Microsoft.ApiManagement/service/apis/operations",
      "apiVersion": "2021-08-01",
      "name": "[format('{0}/{1}/update-driver-location', parameters('apiManagementName'), variables('driverMatchingApiName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service/apis', parameters('apiManagementName'), variables('driverMatchingApiName'))]"
      ],
      "properties": {
        "displayName": "Update Driver Location",
        "method": "POST",
        "urlTemplate": "/driver-location",
        "description": "Update a driver's current location for real-time tracking"
      }
    }
  ],
  "outputs": {
    "functionAppUrl": {
      "type": "string",
      "value": "[reference(variables('functionAppId')).defaultHostName]"
    },
    "apiManagementUrl": {
      "type": "string",
      "value": "[reference(variables('apiManagementId')).gatewayUrl]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[parameters('storageAccountName')]"
    },
    "signalRConnectionString": {
      "type": "string",
      "value": "[listKeys(variables('signalRId'), '2022-02-01').primaryConnectionString]"
    },
    "appInsightsInstrumentationKey": {
      "type": "string",
      "value": "[reference(variables('appInsightsId'), '2020-02-02').InstrumentationKey]"
    }
  }
}